# Copiar a .env (no versionar) o definir en el servicio.
ANTHROPIC_API_KEY=
# Debe coincidir con googleClientId de js/config.js; el proxy rechaza tokens de otros clientes.
GOOGLE_CLIENT_ID=
# Restringe el asistente a cuentas del dominio corporativo (ej. pemex.com).
ALLOWED_DOMAIN=
# 1 = permite el asistente sin sesión Google. SOLO para piloto en red cerrada.
ALLOW_ANON=0
PORT=8080
# Consultas por usuario cada 10 min.
RATE_MAX=30
